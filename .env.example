# Server (Render) env vars — set in the Render dashboard, never commit real values.
PORT=10000
NODE_ENV=production
CLIENT_URL=https://your-frontend.vercel.app
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# Client (Vercel) env var — set in the Vercel dashboard.
VITE_API_BASE_URL=https://your-backend.onrender.com