# Environment variables template.
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file.

# Backend
PORT=5000
CLIENT_URL=http://localhost:3000

# Database / Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
TOTP_ENCRYPTION_KEY=

# Crypto
CRYPTO_CONFIGURATION=

# Deployment (populated when deploying)
# NODE_ENV=production
